{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secapp:observation:defender-protection:1",
  "title": "Imported Defender protection state",
  "description": "All fields are SensitiveSecurityData. Missing fields represent missing coverage. This is a normalized producer contract, not a collector implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "mode": { "type": "string", "enum": ["Active", "Passive", "Disabled", "Unknown", "Unsupported"] },
    "real_time_protection": { "type": "string", "enum": ["Enabled", "Disabled", "Unknown", "Unsupported"] }
  },
  "examples": [{ "schema_version": "1.0.0", "mode": "Active", "real_time_protection": "Enabled" }]
}
